# This repository intentionally contains custom WordPress theme code only.
/*
!/.gitignore
!/wp-content/
!/tools/

# Exclude everything under wp-content except themes.
/wp-content/*
!/wp-content/themes/

# Must-use plugins: only the Glover Google Workspace plugin is project code.
!/wp-content/mu-plugins/
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/glover-google.php
!/wp-content/mu-plugins/glover-google/

# WordPress default themes can be reinstalled from WordPress itself.
/wp-content/themes/twentytwenty*/

# Local metadata and generated dependencies.
**/.DS_Store
**/.git/
**/node_modules/
**/.cache/
**/.parcel-cache/
**/.sass-cache/
**/*.log

# Local bundles, theme backups, and licensed package archives.
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
